node_modules/
debug/
.DS_Store
world/saves/

# generated paloptic atlas sidecar, copied from $GAIA_WORLD for same-origin fetch
client/atlas-graph.json

# THE FILM'S MUSIC. 35 MB of stems + full mix for the opening cinematic,
# fetched at runtime from /assets/audio/beginning/ — too large for the repo
# and not ours to redistribute. It does NOT need to be tracked to SHIP:
# vite.config.js's copyStaticAssets plugin cpSync's the whole client/assets
# tree into dist/ on `vite build`, tracked or not (verified against the
# config, 2026-07-28). Keep the files on disk; a checkout without them still
# runs — director.buildAudio()'s canplaythrough/error listeners both resolve
# and the film rolls silent.
# client/assets/audio/bloodborne/ is deliberately NOT ignored: those 12 voice
# clips (1.6 MB) are already committed and are what the eggs speak with.
client/assets/audio/beginning/

# vite production build output (static-mode deploy target) — regenerated by
# `GAIA_STATIC_BUILD=1 vite build`, never hand-edited, too large to commit
dist/

# wrangler local dev state/cache — regenerated by `wrangler pages dev`
.wrangler/
