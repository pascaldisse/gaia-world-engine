node_modules/
debug/
.DS_Store
world/saves/
# every world keeps its own save dir — live player state, same class as
# world/saves/ above: runtime, regenerated on connect, never repo content
worlds/*/saves/

# generated paloptic atlas sidecar, copied from $GAIA_WORLD for same-origin fetch
client/atlas-graph.json

# Required shipped audio: opening score/subtitle payloads and Bloodborne clips.
# Keep both paths tracked: a fresh checkout must play the film and NPC voices.
# client/assets/audio/beginning/
# client/assets/audio/bloodborne/

# vite production build output (static-mode deploy target) — regenerated by
# `GAIA_STATIC_BUILD=1 vite build`, never hand-edited, too large to commit
dist/

# wrangler local dev state/cache — regenerated by `wrangler pages dev`
.wrangler/
node_modules

.scratch/

# gaia-daemon per-project room state (live runtime, never repo content)
.gaia/
